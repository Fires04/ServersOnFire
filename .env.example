NETBOX_URL=http://netbox.example.lan:8899
NETBOX_TOKEN=changeme

# Only devices/VMs tagged with this NetBox tag are shown
DISPLAY_TAG=netmap

# Color theme a fresh browser lands on (the in-app picker, top right,
# always wins after that — this is just the starting point). One of:
# signal (cyan), aurora (violet), copper (warm/muted orange), slate (indigo).
DEFAULT_THEME=copper

REFRESH_INTERVAL_MINUTES=5

# Set to true to require ServersOnFire's own login form (in addition to
# whatever sits in front of it, e.g. Authentik via NPM). Off by default:
# LAN access on the published port is left open, internet access is gated
# by Authentik — same policy as netmap.
REQUIRE_LOGIN=false

# Only needed if REQUIRE_LOGIN=true
APP_USERNAME=changeme
APP_PASSWORD=changeme
# Random secret for signing session cookies — generate with: openssl rand -hex 32
SESSION_SECRET=changeme

# Set to true once the app is served over HTTPS (e.g. behind Nginx Proxy Manager)
COOKIE_HTTPS_ONLY=false

# Optional: adds a "Sign in with Authentik" button next to the password
# form (REQUIRE_LOGIN must also be true). Leave any of these blank/unset
# to skip it entirely — password login keeps working on its own either
# way. See https://github.com/Fires04/FireAuth's README for the Authentik-
# side setup (create an OAuth2/OIDC Provider + Application there first).
# AUTHENTIK_CLIENT_ID=
# AUTHENTIK_CLIENT_SECRET=
# AUTHENTIK_ISSUER=https://authentik.example.lan/application/o/serversonfire/
# AUTHENTIK_REDIRECT_URI=https://serversonfire.example.lan/auth/callback
